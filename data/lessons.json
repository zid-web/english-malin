        {
          "id": "l2-cafe",
          "type": "article",
          "title": "At the café",
          "audio": {
            "duration": 45
          },
          "text": [
            "Waiter: Good morning! What would you like?",
            "Lucas: I'd like a hot chocolate and a muffin, please. How much is it?",
            "Waiter: That's four pounds fifty. Would you like anything else?",
            "Lucas: No, thank you. Can I pay by card?"
          ],
          "grammar": {
            "title": "Commander poliment : would like",
            "rule": "« I'd like… » (= I would like) est plus poli que « I want… ». Question : « Would you like…? ». Pour un prix : « How much is it? »."
          },
          "quiz": [
            {
              "q": "What does Lucas order?",
              "choices": [
                "a tea and a cake",
                "a hot chocolate and a muffin",
                "a coffee"
